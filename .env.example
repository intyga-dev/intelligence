# --- Database (own Postgres — never Intyga's) ---
# DATABASE_URL is the runtime connection. DIRECT_URL is used by the Prisma CLI for migrations and
# must bypass any connection pooler. Locally they are the same; in production they differ.
DATABASE_URL="postgresql://intelligence:dev-local-only@localhost:5434/intelligence_dev"
DIRECT_URL="postgresql://intelligence:dev-local-only@localhost:5434/intelligence_dev"

# --- Server ---
PORT="4100"
LOG_LEVEL="info"
# Bearer token for POST /internal/tick, held by whatever schedules it. Not a user credential.
TICK_TOKEN="dev-tick-token-change-me"
# Proves you operate this instance when completing first-time setup in the browser (/settings/bind).
# Without it, whoever reached a fresh deployment first could bind it to their own workspace. Used once;
# unset in production disables browser setup, leaving scripts/bind-workspace.ts as the only way in.
# Generate with: openssl rand -base64 32
SETUP_TOKEN="dev-setup-token-change-me"

# Optional: a separate database for the setup/enrolment route tests. The suite TRUNCATES it, so the
# name must contain "test". Unset, those tests are skipped. Never point this at the dev database.
# TEST_DATABASE_URL="postgresql://intelligence:dev-local-only@localhost:5434/intelligence_test"

# --- Intyga Relying Party (REQUIRED — Intelligence has no authentication of its own) ---
# Unset means every privileged action is REFUSED, never that it is allowed. Set these with
# scripts/bind-workspace.ts rather than by hand; it writes the encrypted binding to the tenant row.
#
# The key is PLATFORM-scoped (subjects:write, credentials:write, receipts:create, receipts:read) and
# authenticates by private_key_jwt. It acts only on Intelligence's own subjects and cannot approve,
# bypass or read anything in Intyga's own plane.
# INTYGA_RP_URL="https://api.staging.intyga.com"
# INTYGA_RP_CLIENT_ID=""
# PKCS#8 PEM. Newlines may be \n-escaped for environments that cannot carry real ones.
# INTYGA_RP_PRIVATE_KEY=""
# Our OWN WebAuthn RP id and the exact origin Intelligence is served from — not Intyga's.
# INTYGA_RP_ID="localhost"
# INTYGA_RP_ORIGIN="http://localhost:4100"

# --- Ingest cost guards ---
# Token buckets on POST /ingest/:kind/:connectionId. A cost guard, not an authentication control:
# the HMAC decides whether a delivery is real, these only bound what it costs to find out.
# In-process, so per-instance. See src/server/ratelimit.ts.
INGEST_RATE_GLOBAL_PER_MIN="1200"
INGEST_RATE_PER_CONNECTION_PER_MIN="300"

# --- Judgment provider (TypeSafe AI / JEV) ---
# UNSET IS A VALID CONFIGURATION: with no key the null provider runs, no request ever leaves, and
# every deterministic detector still works. Do not set this before the DPA and zero-data-retention
# are in place — see README.
#
# TYPESAFE_* is the canonical spelling. JEV_API_KEY / JEV_MODEL / JEV_ENDPOINT are the earlier names
# and are still read. Set one family, not both — the canonical name wins silently, which is the
# wrong thing to be debugging at 2am.
# TYPESAFE_API_KEY=""
TYPESAFE_MODEL="jev-latest"
TYPESAFE_TIMEOUT_MS="10000"

# --- GitHub connector ---
# Fine-grained, READ-ONLY: contents:read, pull_requests:read, actions:read. Nothing that can write.
# GITHUB_TOKEN=""

# --- Encryption at rest for connection secrets ---
# 32 bytes, base64. Generate with: openssl rand -base64 32
SECRETS_ENC_KEY="dev-secrets-enc-key-change-me-32b"

# NOTE ON WHAT IS DELIBERATELY ABSENT: no INTYGA_API_KEY, no operator or service token
# (METRICS_TOKEN, SWEEP_TOKEN), no INTYGA_DATABASE_URL. scripts/check-no-intyga-client.mjs fails the
# build if one appears.
#
# The rule is not "never talk to Intyga" — the RP variables above are exactly Intelligence asking
# Intyga for a human approval, which is the boundary working. The rule is that Intelligence may ask
# for permission and may never hold the power to grant it, bypass it, or read across it.
