# INTYGA Intelligence — production environment. Every variable the server and scripts read.
#
# Copy to a secret store, not into the repository. docs/PRODUCTION.md walks through each value.
# The server REFUSES TO START (exit 1) when DATABASE_URL, TICK_TOKEN or SECRETS_ENC_KEY is missing
# or a placeholder, or when SETUP_TOKEN is set to a placeholder.

NODE_ENV=production
PORT=4100
LOG_LEVEL=info

# ─── Database — your own Postgres, never INTYGA's ───────────────────────────────────────────────
# Runtime connection (a pooler is fine).
DATABASE_URL=
# Direct connection for `prisma migrate deploy` only — must bypass any transaction pooler.
DIRECT_URL=

# ─── Secrets. Generate each with: openssl rand -base64 32 ──────────────────────────────────────
# Bearer token for POST /internal/tick, held by your scheduler.
TICK_TOKEN=
# Encrypts every stored credential: connector tokens and webhook secrets, alert destinations, the
# INTYGA platform key. PERMANENT — losing or changing it means re-entering all of them.
SECRETS_ENC_KEY=
# First-time setup in the browser. Remove it once setup is done: unset disables browser setup, and
# the CLI (scripts/bind-workspace.ts) remains the way in.
SETUP_TOKEN=

# ─── INTYGA workspace binding — OPTIONAL here ───────────────────────────────────────────────────
# Normally stored (encrypted) in the database by browser setup or scripts/bind-workspace.ts. Set
# these only to bind from the environment instead; a database binding takes precedence.
# INTYGA_RP_URL=https://api.intyga.com
# INTYGA_RP_CLIENT_ID=
# PKCS#8 PEM, ES256 (P-256). \n-escaped newlines are accepted here.
# INTYGA_RP_PRIVATE_KEY=
# INTYGA_RP_ID=intelligence.example.com
# INTYGA_RP_ORIGIN=https://intelligence.example.com
# INTYGA_RP_TIMEOUT_MS=10000

# ─── Used by the operator scripts for printed links ─────────────────────────────────────────────
PUBLIC_URL=https://intelligence.example.com

# ─── Ingest cost guards (per instance) ──────────────────────────────────────────────────────────
INGEST_RATE_GLOBAL_PER_MIN=1200
INGEST_RATE_PER_CONNECTION_PER_MIN=300

# ─── Optional: GitHub polling (fine-grained, READ-ONLY token) ───────────────────────────────────
# Usually set per connector in the console instead.
# GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com

# ─── Optional: judgment provider. UNSET = nothing leaves the host. Sign the DPA first. ──────────
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_TIMEOUT_MS=10000
