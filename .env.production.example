# INTYGA Intelligence — production environment. Every variable the server and scripts read.
#
# Copy to a secret store, not into the repository. docs/PRODUCTION.md walks through each value.
# The server REFUSES TO START (exit 1) when DATABASE_URL, TICK_TOKEN or SECRETS_ENC_KEY is missing
# or a placeholder. Missing INTYGA configuration keeps sign-in and privileged routes closed.

NODE_ENV=production
PORT=4100
LOG_LEVEL=info

# ─── Database — your own Postgres, never INTYGA's ───────────────────────────────────────────────
# Runtime connection (a pooler is fine).
DATABASE_URL=
# Direct connection for `prisma migrate deploy` only — must bypass any transaction pooler.
DIRECT_URL=

# ─── Secrets. Generate each with: openssl rand -base64 32 ──────────────────────────────────────
# Bearer token for POST /internal/tick, held by your scheduler.
TICK_TOKEN=
# Encrypts connector tokens, webhook secrets and alert destinations. Keep a backup.
SECRETS_ENC_KEY=

# ─── INTYGA connection — environment and mounted file are the only source of authority ────────
INTYGA_URL=https://api.intyga.com
INTYGA_WORKSPACE_ID=
INTYGA_SERVICE_CLIENT_ID=
INTYGA_SERVICE_CLIENT_SECRET=
INTYGA_TRUST_ANCHOR_FILE=/run/config/intyga-trust-anchor.json
# Optional: named workspace identity/role sign-in in addition to ordinary approval sign-in.
# Register <PUBLIC_URL>/auth/callback under Integrations → App sign-in.
INTYGA_OIDC_CLIENT_ID=
# INTYGA_TIMEOUT_MS=10000

# ─── External origins for sign-in, approval targets and webhook links ─────────────────────────────
PUBLIC_URL=https://intelligence.example.com
INTYGA_CONSOLE_URL=https://app.intyga.com

# Optional private route to the gateway named by INTYGA_URL. Public sign-in URLs and issuer
# verification still use INTYGA_URL; keep this unset unless you operate that network route.
# INTYGA_INTERNAL_URL=https://gateway.internal.example.com

# ─── Ingest cost guards (per instance) ──────────────────────────────────────────────────────────
INGEST_RATE_GLOBAL_PER_MIN=1200
INGEST_RATE_PER_CONNECTION_PER_MIN=300

# ─── Optional: GitHub polling (fine-grained, READ-ONLY token) ───────────────────────────────────
# Usually set per connector in the console instead.
# GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com

# ─── Optional: judgment provider. UNSET = nothing leaves the host. Sign the DPA first. ──────────
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_TIMEOUT_MS=10000

# Member-bound embedded approvals (register in INTYGA → Member applications).
INTYGA_EMBEDDED_APPLICATION_ID=""
INTYGA_EMBEDDED_REGISTRATION_FILE="./config/intyga-embedded-registration.json"
