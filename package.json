{
  "name": "intyga-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Operational attention compression: correlates telemetry, CI, deploys and authorization events into a short list of evidence-backed findings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intyga-dev/intyga-intelligence.git"
  },
  "homepage": "https://github.com/intyga-dev/intyga-intelligence#readme",
  "bugs": {
    "url": "https://github.com/intyga-dev/intyga-intelligence/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --experimental-strip-types 'src/**/*.test.ts'",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:boundary": "node scripts/check-no-intyga-client.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:boundary && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
